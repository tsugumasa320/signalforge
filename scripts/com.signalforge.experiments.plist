<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.signalforge.experiments</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>REPLACE_WITH_REPO/scripts/resume-experiments.sh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>REPLACE_WITH_REPO</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Hour</key>
      <integer>22</integer>
      <key>Minute</key>
      <integer>0</integer>
    </dict>
  </array>
  <key>StandardOutPath</key>
  <string>REPLACE_WITH_REPO/data/reports/experiments_launchd.log</string>
  <key>StandardErrorPath</key>
  <string>REPLACE_WITH_REPO/data/reports/experiments_launchd.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
